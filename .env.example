# Database
DATABASE_URL="postgresql://username:password@localhost:5432/textures_almaty"

# Authentication
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRY="1d"

# API Keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Image Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="./public/uploads"

# App Settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"  # production for production environment 
 